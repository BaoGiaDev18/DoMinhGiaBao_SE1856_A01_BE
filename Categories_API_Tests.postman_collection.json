						"    const json = pm.response.json();",
						"    pm.expect(json.data.categoryId).to.be.a('number');",
						"    const categoryId = json.data.categoryId;",
						"    pm.collectionVariables.set('testCategoryId', categoryId);",
						"    pm.environment.set('testCategoryId', categoryId);",
						"    console.log('Category ID saved:', categoryId);",
						"});"
					]
				}
			}]
